  ],
  "calculus": "ZX",
  "fragment": "universal",
  "group": "spiders",
  "order": 1,
  "summary": "Adjacent spiders of the same colour fuse together, and their phases add.",
  "description": "Two spiders of the same colour that are connected by one or more wires can be fused into a single spider, whose phase is the sum of the two phases. Read from right to left, this rule *unfuses* a spider into two, distributing the phase arbitrarily over the two.\n\nThe rule holds for any number of inputs and outputs on either spider. If the spiders are connected by more than one wire, the extra wires become self-loops, which can then be removed with the [self-loop removal](../self-loop-removal/) rule.",
  "variables": {
    "alpha": "real",
    "beta": "real"
  },
  "parameter_notes": "Shown for two spiders with two legs each; holds for any number of legs.",
  "scalar": "1",
  "source": {
    "bib": "CD1"
  },
