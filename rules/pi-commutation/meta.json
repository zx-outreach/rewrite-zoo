  "group": "copy",
  "order": 2,
  "summary": "A π phase copies through a spider of the opposite colour, flipping the sign of its phase.",
  "description": "An X-spider with phase π (the Pauli X gate) can be pushed through a Z-spider with phase α. The π phase is copied to all the other legs of the Z-spider, and the phase α is negated. Up to the global phase $e^{iα}$, this expresses the identity Z(α)X = X Z(−α).\n\nThe same holds with the colours interchanged: a Pauli Z gate commutes through an X-spider.",
  "variables": {
    "alpha": "real"
  },
  "parameter_notes": "m is the number of other legs of the spider (shown for m = 2); holds for any m.",
  "scalar": "exp(I*alpha)",
