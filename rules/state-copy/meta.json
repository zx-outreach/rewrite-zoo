  "calculus": "ZX",
  "fragment": "universal",
  "group": "copy",
  "order": 1,
  "summary": "A computational-basis state copies through a Z-spider.",
  "description": "An X-spider with phase aπ (where a ∈ {0, 1}) and a single leg is, up to a scalar, the computational basis state |a⟩. When it is plugged into a Z-spider, the Z-spider copies it to all of its other legs. The phase of the Z-spider only contributes a global phase $e^{iaα}$.\n\nWith the colours swapped, the states |+⟩ and |−⟩ copy through X-spiders.",
  "variables": {
    "alpha": "real",
    "a": "boolean"
  },
  "parameters": {
    "n": 2
  },
  "parameter_notes": "n is the number of output legs of the Z-spider (shown for n = 2).",
  "scalar": "exp(I*a*alpha)*sqrt(2)**(-(n-1))",
