  "calculus": "ZX",
  "fragment": "universal",
  "group": "pivoting",
  "order": 1,
  "view": "graph-like",
  "summary": "Two connected internal spiders with Pauli phases can be removed by complementing the edges between their neighbourhoods.",
  "description": "In a graph-like diagram, two connected internal spiders u and v with phases jπ and kπ can be removed. Their neighbours fall into three groups: those connected only to u, those connected to both, and those connected only to v. Every pair of spiders taken from two *different* groups has its connectivity toggled (this is the graph-theoretic *pivot* along the edge uv). The neighbours of only u get kπ added to their phase, those of only v get jπ, and the shared neighbours get (j+k+1)π.\n\nThe rule follows from three local complementations. Together with [local complementation](../local-complementation/) it is the main simplification rule of PyZX.",
  "variables": {
    "j": "boolean",
    "k": "boolean",
    "alpha": "real",
    "beta": "real",
    "gamma": "real"
  },
  "parameters": {
    "n_u": 2,
    "n_w": 1,
    "n_v": 2
  },
  "parameter_notes": "n_u, n_w and n_v are the numbers of neighbours of only u, of both, and of only v (shown for n_u = 2, n_w = 1, n_v = 2). The neighbours may have any number of further legs and edges.",
  "scalar": "(-1)**(j*k)*sqrt(2)**((n_u-1)*(n_v-1)+n_w*(n_u+n_v-2))",
  "source": {
    "bib": "duncan2019graph"
  },
